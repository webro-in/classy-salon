{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": { "@/*": ["./src/*"], "@content/*": ["./content/*"] }
  },
  "include": ["vite.config.ts", "vitest.config.ts", "playwright.config.ts", "scripts", "tests/e2e", "src/app/paths.ts", "src/app/prerender.ts"]
}
